# Copy to .env and fill in. Only the three vendors below were used in the study.
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-5-nano

GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

GROK_API_KEY=your-grok-api-key-here
GROK_MODEL=grok-4-fast-reasoning

# The pipeline also has an Anthropic connector; it was not used for any reported result.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

DB_TYPE=sqlite
DB_PATH=data_private/results.db
